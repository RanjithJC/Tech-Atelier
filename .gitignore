# ============================================================
# DATASETS
# ============================================================
#
# Generated datasets should NOT be uploaded to GitHub.
# They can be regenerated using generate_dataset.py
# and the preparation/label scripts.
#

data/*.csv
data/*.xlsx
data/*.xls
data/*.json
data/*.parquet


# ============================================================
# MACHINE LEARNING MODELS
# ============================================================
#
# Large trained models should NOT be stored in Git.
# They can be regenerated using the training scripts.
#

models/*.pkl
models/*.joblib
models/*.h5
models/*.keras
models/*.pt
models/*.pth
models/*.onnx


